{
  "name": "hichki",
  "private": true,
  "version": "2.5.0",
  "description": "Hichki — local-first 1:1 chat, journal and music app",
  "scripts": {
    "prepare:web": "node --import ./scripts/local-netlify-fetch.mjs scripts/prepare-web.mjs && node scripts/ensure-vendored-source.mjs && node scripts/inject-hichki-bridge.mjs",
    "dev": "npm run prepare:web && vite",
    "build": "npm run prepare:web && vite build",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  }
}
